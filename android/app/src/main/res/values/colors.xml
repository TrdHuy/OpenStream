    <color name="os_background">#FF111111</color>
    <color name="os_white">#FFFFFFFF</color>
    <color name="os_transparent">#00000000</color>
    
    <!-- ── Accents ── -->
    <color name="os_accent">#FFFFFFFF</color> <!-- Monochromatic accent -->
    <color name="os_accent_dim">#B3FFFFFF</color>
