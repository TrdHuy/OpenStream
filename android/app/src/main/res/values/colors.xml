    <color name="os_glass_surface">#26FFFFFF</color> <!-- 15% White -->
    <color name="os_glass_border">#33FFFFFF</color>  <!-- 20% White -->
    <color name="os_glass_surface_dark">#40000000</color> <!-- 25% Black -->
    
