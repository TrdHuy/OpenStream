<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/os_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingTop="56dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cấu hình phát"
            android:textColor="@color/os_text_primary"
            android:textSize="32sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROFILE"
            android:textColor="@color/os_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/settingsProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/settingsProfileName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Tên profile, ví dụ Studio 4K30"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:inputType="textCapSentences"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <Button
                android:id="@+id/btnNewProfile"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Mới"
                android:textAllCaps="false"
                android:background="@drawable/bg_minimal_btn_ghost"
                android:textColor="@color/os_text_primary" />

            <Button
                android:id="@+id/btnUseProfile"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Dùng"
                android:textAllCaps="false"
                android:background="@drawable/bg_minimal_btn_ghost"
                android:textColor="@color/os_text_primary" />

            <Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Lưu"
                android:textAllCaps="false"
                android:background="@drawable/bg_minimal_btn_ghost"
                android:textColor="@color/os_text_primary" />

            <Button
                android:id="@+id/btnDeleteProfile"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Xóa"
                android:textAllCaps="false"
                android:background="@drawable/bg_minimal_btn_ghost"
                android:textColor="@color/os_text_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAMERA VÀ MÃ HÓA"
            android:textColor="@color/os_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/settingsPreset"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/settingsPresetNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preset chỉ được áp dụng khi Camera2 + H.264 phần cứng xác nhận hỗ trợ."
            android:textColor="@color/os_text_tertiary"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/settingsCapabilityLens"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chế độ video"
                android:textColor="@color/os_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
            <ImageButton
                android:id="@+id/helpCapabilityMode"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_menu_help"
                android:contentDescription="Help" />
        </LinearLayout>

        <Spinner
            android:id="@+id/settingsCapabilityMode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/settingsCapabilityNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chỉ các tổ hợp Camera2 + AVC phần cứng hợp lệ mới xuất hiện."
            android:textColor="@color/os_text_tertiary"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <EditText android:id="@+id/settingsWidth" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:inputType="number" />
        <EditText android:id="@+id/settingsHeight" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:inputType="number" />
        <EditText android:id="@+id/settingsFps" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:inputType="number" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bitrate Video (Mbps)"
                android:textColor="@color/os_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
            <ImageButton
                android:id="@+id/helpVideoBitrate"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_menu_help"
                android:contentDescription="Help" />
        </LinearLayout>

        <EditText
            android:id="@+id/settingsBitrateMbps"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Ví dụ: 12-35"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chế độ Bitrate"
                android:textColor="@color/os_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
            <ImageButton
                android:id="@+id/helpBitrateMode"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_menu_help"
                android:contentDescription="Help" />
        </LinearLayout>

        <Spinner
            android:id="@+id/settingsVideoBitrateMode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Profile H.264"
                android:textColor="@color/os_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
            <ImageButton
                android:id="@+id/helpH264Profile"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_menu_help"
                android:contentDescription="Help" />
        </LinearLayout>

        <Spinner
            android:id="@+id/settingsAvcProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">
            <CheckBox
                android:id="@+id/settingsBFrames"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="B-frame"
                android:textColor="@color/os_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
            <ImageButton
                android:id="@+id/helpBFrames"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_menu_help"
                android:contentDescription="Help" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chu kỳ Keyframe (s)"
                android:textColor="@color/os_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
            <ImageButton
                android:id="@+id/helpKeyframeInterval"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_menu_help"
                android:contentDescription="Help" />
        </LinearLayout>

        <EditText
            android:id="@+id/settingsKeyframeInterval"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Ví dụ: 2"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ÂM THANH"
            android:textColor="@color/os_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/settingsAudioEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phát âm thanh từ micro"
            android:textColor="@color/os_text_primary"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sample Rate (Hz)"
                android:textColor="@color/os_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
            <ImageButton
                android:id="@+id/helpAudioSampleRate"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_menu_help"
                android:contentDescription="Help" />
        </LinearLayout>

        <EditText
            android:id="@+id/settingsAudioSampleRate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Ví dụ: 48000"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Audio Channels"
                android:textColor="@color/os_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
            <ImageButton
                android:id="@+id/helpAudioChannels"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_menu_help"
                android:contentDescription="Help" />
        </LinearLayout>

        <EditText
            android:id="@+id/settingsAudioChannels"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="1 (Mono) hoặc 2 (Stereo)"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bitrate Âm (kbps)"
                android:textColor="@color/os_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
            <ImageButton
                android:id="@+id/helpAudioBitrate"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_menu_help"
                android:contentDescription="Help" />
        </LinearLayout>

        <EditText
            android:id="@+id/settingsAudioBitrateKbps"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Ví dụ: 128"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KẾT NỐI SRT"
            android:textColor="@color/os_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OBS Host"
                android:textColor="@color/os_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
            <ImageButton
                android:id="@+id/helpObsHost"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_menu_help"
                android:contentDescription="Help" />
        </LinearLayout>

        <EditText
            android:id="@+id/settingsObsHost"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="VD: 192.168.1.100"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:textSize="16sp"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:inputType="textUri"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OBS Port"
                android:textColor="@color/os_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
            <ImageButton
                android:id="@+id/helpObsPort"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_menu_help"
                android:contentDescription="Help" />
        </LinearLayout>

        <EditText
            android:id="@+id/settingsObsPort"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Mặc định: 9000"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:textSize="16sp"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SRT Latency (ms)"
                android:textColor="@color/os_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
            <ImageButton
                android:id="@+id/helpLatency"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_menu_help"
                android:contentDescription="Help" />
        </LinearLayout>

        <EditText
            android:id="@+id/settingsLatency"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="VD: 120 hoặc 2000"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:textSize="16sp"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Listening Port"
                android:textColor="@color/os_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
            <ImageButton
                android:id="@+id/helpListeningPort"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@android:drawable/ic_menu_help"
                android:contentDescription="Help" />
        </LinearLayout>

        <EditText
            android:id="@+id/settingsListeningPort"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Mặc định: 9000"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:textSize="16sp"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnSaveAndConnect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:background="@drawable/bg_minimal_btn"
            android:text="Lưu và kết nối"
            android:textAllCaps="false"
            android:textColor="@color/os_black"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:background="@drawable/bg_minimal_btn_ghost"
            android:text="Lưu cấu hình"
            android:textAllCaps="false"
            android:textColor="@color/os_text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnBackSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:background="@drawable/bg_minimal_btn_ghost"
            android:text="Quay lại"
            android:textAllCaps="false"
            android:textColor="@color/os_text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="32dp" />

        <TextView
            android:id="@+id/settingsVersionInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/os_text_tertiary"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
