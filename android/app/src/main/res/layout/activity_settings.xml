<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/os_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingTop="56dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cấu hình phát"
            android:textColor="@color/os_text_primary"
            android:textSize="32sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAMERA VÀ MÃ HÓA"
            android:textColor="@color/os_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/settingsCapabilityLens"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/settingsCapabilityMode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/settingsCapabilityNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chỉ các tổ hợp Camera2 + AVC phần cứng hợp lệ mới xuất hiện. Chọn cùng ống kính ở màn hình camera khi phát."
            android:textColor="@color/os_text_tertiary"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/settingsWidth"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:inputType="number" />

        <EditText
            android:id="@+id/settingsHeight"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:inputType="number" />

        <EditText
            android:id="@+id/settingsFps"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:inputType="number" />

        <EditText
            android:id="@+id/settingsBitrateMbps"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Tốc độ bit hình (Mbps), ví dụ 12"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/settingsKeyframeInterval"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Chu kỳ khung hình khóa (giây)"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ÂM THANH"
            android:textColor="@color/os_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/settingsAudioEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phát âm thanh từ micro"
            android:textColor="@color/os_text_primary"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/settingsAudioSampleRate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Tần số lấy mẫu, ví dụ 48000"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/settingsAudioChannels"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Số kênh âm thanh: 1 hoặc 2"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/settingsAudioBitrateKbps"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Tốc độ bit âm thanh (kbps), ví dụ 128"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KẾT NỐI SRT"
            android:textColor="@color/os_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/settingsObsHost"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Tên máy hoặc địa chỉ IP của OBS"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:textSize="16sp"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:inputType="textUri"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/settingsObsPort"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Cổng OBS, mặc định 9000"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:textSize="16sp"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/settingsLatency"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Độ trễ SRT (ms), ví dụ 120 hoặc 2000"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:textSize="16sp"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/settingsListeningPort"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Cổng lắng nghe, mặc định 9000"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:textSize="16sp"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnSaveAndConnect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:background="@drawable/bg_minimal_btn"
            android:text="Lưu và kết nối"
            android:textAllCaps="false"
            android:textColor="@color/os_black"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:background="@drawable/bg_minimal_btn_ghost"
            android:text="Lưu cấu hình"
            android:textAllCaps="false"
            android:textColor="@color/os_text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnBackSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:background="@drawable/bg_minimal_btn_ghost"
            android:text="Quay lại"
            android:textAllCaps="false"
            android:textColor="@color/os_text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="32dp" />

        <TextView
            android:id="@+id/settingsVersionInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/os_text_tertiary"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
