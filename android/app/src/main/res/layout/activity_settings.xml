<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/os_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingTop="56dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_screen_title"
            android:textColor="@color/os_text_primary"
            android:textSize="32sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_profile"
            android:textColor="@color/os_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/settingsProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/settingsProfileName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/settings_profile_name_example_hint"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:inputType="textCapSentences"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <Button
                android:id="@+id/btnNewProfile"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/settings_profile_new"
                android:textAllCaps="false"
                android:background="@drawable/bg_minimal_btn_ghost"
                android:textColor="@color/os_text_primary" />

            <Button
                android:id="@+id/btnUseProfile"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/settings_profile_use"
                android:textAllCaps="false"
                android:background="@drawable/bg_minimal_btn_ghost"
                android:textColor="@color/os_text_primary" />

            <Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/settings_profile_save_short"
                android:textAllCaps="false"
                android:background="@drawable/bg_minimal_btn_ghost"
                android:textColor="@color/os_text_primary" />

            <Button
                android:id="@+id/btnDeleteProfile"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/settings_profile_delete"
                android:textAllCaps="false"
                android:background="@drawable/bg_minimal_btn_ghost"
                android:textColor="@color/os_text_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_camera_encoding"
            android:textColor="@color/os_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/settingsPreset"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/settingsPresetNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_preset_note"
            android:textColor="@color/os_text_tertiary"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/settingsCapabilityLens"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/settingsCapabilityMode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/settingsCapabilityNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_capability_note"
            android:textColor="@color/os_text_tertiary"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <EditText android:id="@+id/settingsWidth" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:inputType="number" />
        <EditText android:id="@+id/settingsHeight" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:inputType="number" />
        <EditText android:id="@+id/settingsFps" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:inputType="number" />

        <EditText
            android:id="@+id/settingsBitrateMbps"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/settings_video_bitrate_hint"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/settingsVideoBitrateMode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/settingsAvcProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/settingsBFrames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_bframes"
            android:textColor="@color/os_text_primary"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/settingsKeyframeInterval"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/settings_keyframe_hint"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_audio"
            android:textColor="@color/os_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/settingsAudioEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_audio_enabled"
            android:textColor="@color/os_text_primary"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/settingsAudioSampleRate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/settings_audio_sample_rate_hint"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/settingsAudioChannels"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/settings_audio_channels_hint"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/settingsAudioBitrateKbps"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/settings_audio_bitrate_hint"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_srt"
            android:textColor="@color/os_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/settingsObsHost"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/settings_obs_host_hint"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:textSize="16sp"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:inputType="textUri"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/settingsObsPort"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/settings_obs_port_hint"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:textSize="16sp"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/settingsLatency"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/settings_latency_hint"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:textSize="16sp"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/settingsListeningPort"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/settings_listening_port_hint"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:textSize="16sp"
            android:inputType="number"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnSaveAndConnect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:background="@drawable/bg_minimal_btn"
            android:text="@string/settings_save_connect_vi"
            android:textAllCaps="false"
            android:textColor="@color/os_black"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:background="@drawable/bg_minimal_btn_ghost"
            android:text="@string/settings_save_vi"
            android:textAllCaps="false"
            android:textColor="@color/os_text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnBackSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:background="@drawable/bg_minimal_btn_ghost"
            android:text="@string/settings_back_vi"
            android:textAllCaps="false"
            android:textColor="@color/os_text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="32dp" />

        <TextView
            android:id="@+id/settingsVersionInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/os_text_tertiary"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
